\frametitle{Code Snippet: Running the Pipeline}
\small
  \begin{lstlisting}[basicstyle=\ttfamily\tiny, frame=single, breaklines=true]
# main.py
parser.add_argument("--config", required=True)
args = parser.parse_args()
controller = PipelineController(args.config)
controller.analyze()
  \end{lstlisting}
  \vspace{0.5em}
  \begin{lstlisting}[basicstyle=\ttfamily\tiny, frame=single, breaklines=true]
# controller.analyze() does:
# 1. set_seed(); 2. DatasetLoader(path)
# 3. PromptBuilder(spec); 4. Model adapter (openai/hf/vllm)
# 5. OutputWriter(); 6. PredictionInconsistency()
# 7. PipelineRunner(dataset, prompt_builder, model, metrics, ...)
# 8. runner.run() -> inference + metrics -> write CSV
  \end{lstlisting}
